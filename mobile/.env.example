# Copy to .env — EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# Android emulator -> host machine: http://10.0.2.2:3000
# Physical device on same Wi-Fi:    http://<your-LAN-IP>:3000
# Production (must be https):        https://<your-render-app>.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
